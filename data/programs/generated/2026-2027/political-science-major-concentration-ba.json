        {
          "title": "36 credits of courses selected from the four main fields of political science (Canadian Politics, Comparative Politics, International Relations, and Political Theory) with the following specifications",
          "unparsed": true
        },
        {
          "title": "Only POLI courses at the 200-level or above (or their equivalent courses from other universities can be counted toward this program",
          "unparsed": true
        },
        {
          "title": "No more than one-half of the credits (18 credits) may be taken in a single field of political science, unless the field is Comparative Politics in which case the maximum is 21 credits",
          "unparsed": true
        },
        {
          "title": "12 of the 36 credits must be taken at the 200 level",
          "unparsed": true
        },
        {
          "title": "No more than 3 credits at the 200 level may be in any given group - the groups being Canadian Politics, Comparative Politics, International Relations, Political Theory, and Methods",
          "unparsed": true
        },
        {
          "title": "All other 24 credits must come from 300- or 400-level POLI courses",
          "unparsed": true
        },
        {
          "title": "3 credits must be taken at the 400 level at McGill rather than as transfer credits",
          "unparsed": true
        },
        {
          "title": "To take a 300- or 400-level POLI course, students must have taken a 200-level POLI course in the same field",
